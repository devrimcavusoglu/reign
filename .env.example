# Example environment configuration for REIGN.
#
# Nothing here is required: every variable has a working default, and no
# credentials are needed — the released dataset, the baseline checkpoints and
# the evaluation benchmarks are all public. The code reads these from the
# process environment (it does not parse this file), so copy it to `.env` and
# `source` it, or export the variables directly.
#
# Only variables the shipping code actually reads are listed below.

# --- Filesystem layout (reign/__init__.py) ---

# Project root. Defaults to the repository root when running from a checkout,
# otherwise to the current working directory.
# REIGN_HOME=.

# Where locally built datasets live. Default: $REIGN_HOME/data
# REIGN_DATA_DIR=./data

# Where training writes checkpoints (--output-dir is resolved relative to it).
# Default: $REIGN_HOME/models
# REIGN_MODEL_DIR=./models

# --- Training behaviour (reign/train.py) ---

# Set to "true" to keep --data-loader-num-workers > 0 on CUDA even when the
# embedding cache is disabled. Off by default because running the guidance
# network inside DataLoader workers can trip CUDA multiprocessing errors.
# REIGN_FORCE_MULTIPROCESSING=false

# --- GPU selection (read by scripts/measure_compute.py for run metadata) ---

# Standard NVIDIA variable; recorded alongside compute measurements so results
# state which device produced them.
# CUDA_VISIBLE_DEVICES=0
